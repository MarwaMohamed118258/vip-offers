rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // الأدمن = حساب الإيميل ده بس (تسجيل الدخول من admin.html)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "m.marwa.mohamed2013@gmail.com";
    }

    function isStr(v, minLen, maxLen) { return v is string && v.size() >= minLen && v.size() <= maxLen; }
    function isNum(v, lo, hi) { return (v is int || v is float) && v >= lo && v <= hi; }

    // ---------- عام: الكل يقرأ، الأدمن بس يكتب ----------
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // settings: about / categories / names / loyalty (المستويات) / bestsellers
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- الطلبات: أي عميل يبعت طلب جديد، والأدمن بس يشوف ويعدّل ----------
    function validOrder(d) {
      return d.keys().hasAll(["customerId", "name", "area", "phone", "items", "total", "status", "createdAt"])
        && d.keys().hasOnly(["customerId", "name", "area", "phone", "items", "total", "totalPublic", "itemsCount", "status", "createdAt", "lang"])
        && d.customerId is string && d.customerId.matches("^[A-Za-z0-9]{24,64}$")
        && isStr(d.name, 1, 100)
        && isStr(d.area, 1, 100)
        && d.phone is string && d.phone.matches("^[+0-9 ]{8,20}$")
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && isNum(d.total, 0, 100000000)
        && (!("totalPublic" in d) || isNum(d.totalPublic, 0, 100000000))
        && (!("itemsCount" in d) || isNum(d.itemsCount, 0, 100000))
        && (!("lang" in d) || d.lang in ["ar", "en"])
        && d.status == "جديد"
        && d.createdAt == request.time;
    }
    match /orders/{orderId} {
      allow create: if validOrder(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // ---------- المكافآت: العميل يقرأ مستنده بالكود بتاعه بس (get مش list)، والأدمن بيحدّثه ----------
    match /loyalty/{customerId} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // ---------- التقييمات ----------
    // rateable/{orderId}_{productKey}: الأدمن بيعمله لما الطلب يبقى «اتسلّم» = إذن بتقييم واحد
    match /rateable/{id} {
      allow get: if true;
      allow list, write: if isAdmin();
    }
    // التقييم: مرة واحدة بس لكل منتج في طلب اتسلّم (نفس الـ ID بتاع rateable)، ومن غير تعديل
    match /ratings/{id} {
      allow read: if true;
      allow create: if exists(/databases/$(database)/documents/rateable/$(id))
        && request.resource.data.keys().hasAll(["orderId", "productKey", "stars", "createdAt"])
        && request.resource.data.keys().hasOnly(["orderId", "productKey", "productId", "productName", "stars", "comment", "commentHidden", "createdAt"])
        && id == request.resource.data.orderId + "_" + request.resource.data.productKey
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && (!("comment" in request.resource.data) || isStr(request.resource.data.comment, 0, 500))
        && (!("productName" in request.resource.data) || isStr(request.resource.data.productName, 0, 200))
        && (!("productId" in request.resource.data) || isStr(request.resource.data.productId, 0, 64))
        && (!("commentHidden" in request.resource.data) || request.resource.data.commentHidden == false)
        && request.resource.data.createdAt == request.time;
      // الأدمن يقدر يخبّي التعليق بس (النجوم بتفضل محسوبة)، أو يمسح التقييم
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["commentHidden"]);
      allow delete: if isAdmin();
    }

    // ---------- الاقتراحات: أي حد يبعت اقتراح (حقول متراجعة)، والأدمن بس يشوف ويعدّل ----------
    function validSuggestion(d) {
      return d.keys().hasAll(["type", "text", "status", "createdAt"])
        && d.keys().hasOnly(["type", "company", "text", "name", "phone", "area", "customerId", "status", "createdAt", "lang"])
        && d.type in ["اقتراح عرض", "منتج جديد", "ملاحظة"]
        && isStr(d.text, 1, 1000)
        && (!("company" in d) || isStr(d.company, 0, 100))
        && (!("name" in d) || isStr(d.name, 0, 100))
        && (!("area" in d) || isStr(d.area, 0, 100))
        && (!("phone" in d) || (d.phone is string && (d.phone == "" || d.phone.matches("^[+0-9 ]{8,20}$"))))
        && (!("customerId" in d) || (d.customerId is string && d.customerId.matches("^[A-Za-z0-9]{24,64}$")))
        && (!("lang" in d) || d.lang in ["ar", "en"])
        && d.status == "جديد"
        && d.createdAt == request.time;
    }
    match /suggestions/{id} {
      allow create: if validSuggestion(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // =====================================================================
    // Offers Store (متجر العروض للجمهور) — نفس قاعدة البيانات
    // =====================================================================
    // الشركات (الاسم، اللوجو، الظهور في VIP / Offers Store) والأسئلة والإجابات: الكل يقرأ، الأدمن بس يكتب
    match /companies/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faq/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // طلبات المتجر: أي حد يبعت طلب جديد بحقول متراجعة، والأدمن بس يشوف ويعدّل
    function validConsumerOrder(d) {
      return d.keys().hasAll(["customerId", "name", "phone", "governorate", "address", "items", "subtotal", "shipping", "total", "status", "createdAt"])
        && d.keys().hasOnly(["customerId", "name", "phone", "governorate", "address", "notes", "items", "companies", "itemsCount", "subtotal", "shipping", "total", "status", "createdAt", "lang"])
        && d.customerId is string && d.customerId.matches("^[A-Za-z0-9]{24,64}$")
        && isStr(d.name, 1, 100)
        && d.phone is string && d.phone.matches("^01[0125][0-9]{8}$")
        && d.governorate in ["القاهرة", "الجيزة", "الإسكندرية", "القليوبية", "الشرقية", "الدقهلية", "الغربية", "المنوفية", "البحيرة",
             "كفر الشيخ", "دمياط", "بورسعيد", "الإسماعيلية", "السويس", "الفيوم", "بني سويف", "المنيا", "أسيوط",
             "سوهاج", "قنا", "الأقصر", "أسوان", "البحر الأحمر", "الوادي الجديد", "مطروح", "شمال سيناء", "جنوب سيناء"]
        && isStr(d.address, 5, 300)
        && (!("notes" in d) || isStr(d.notes, 0, 500))
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && (!("companies" in d) || (d.companies is list && d.companies.size() <= 20))
        && (!("itemsCount" in d) || isNum(d.itemsCount, 1, 100000))
        && isNum(d.subtotal, 0, 10000000)
        && isNum(d.shipping, 0, 100000)
        && isNum(d.total, 0, 10000000)
        && (!("lang" in d) || d.lang in ["ar", "en"])
        && d.status == "جديد"
        && d.createdAt == request.time;
    }
    match /consumerOrders/{orderId} {
      allow create: if validConsumerOrder(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // المتابعة الشهرية: الأدمن بتكتبه لما الطلب يبقى «اتسلّم»، والعميل بيقرا مستنده بالكود بتاعه بس (get مش list)
    match /storeFollowups/{customerId} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // ---------- عدّاد مشاهدات العروض: زيادة 1 بس كل مرة، والأدمن بس يقرأ ----------
    match /views/{offerId} {
      allow create: if request.resource.data.keys().hasOnly(["count"]) && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(["count"]) && request.resource.data.count == resource.data.count + 1;
      allow read, delete: if isAdmin();
    }
  }
}
